<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000004"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000003"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Nightfall Runners :: shared configuration
-- Tweak these numbers to balance the game.

local Config = {}

-- Round flow ---------------------------------------------------------------
Config.MinPlayers = 1                -- solo play works (AI hunter)
Config.IntermissionTime = 20
Config.RoundTime = 240               -- seconds
Config.HunterReleaseDelay = 12       -- head start for runaways
Config.EndingTime = 7

-- Objectives ---------------------------------------------------------------
Config.KeysToSpawn = 7
Config.KeysNeeded = 5

-- Hunters ------------------------------------------------------------------
Config.PlayerHunterMinPlayers = 3    -- with 3+ players one player becomes a Hunter
Config.ExtraHunterEvery = 70         -- spawn another AI hunter every N seconds
Config.MaxAIHunters = 3
Config.HunterPatrolSpeed = 14
Config.HunterChaseSpeed = 19.5
Config.HunterEnragedBonus = 2        -- added to chase speed once the exit opens
Config.FrenzyTime = 45               -- last N seconds: hunters always know where you are
Config.HunterSightRange = 110
Config.HunterHearRange = 18          -- always notices you this close (unless hidden)
Config.HiddenDetectRange = 7         -- hidden players are only found this close
Config.CatchRadius = 4.5
Config.PlayerHunterSpeed = 23

-- Movement -----------------------------------------------------------------
Config.WalkSpeed = 16
Config.SprintSpeed = 26
Config.MaxStamina = 100
Config.StaminaDrain = 24             -- per second while sprinting
Config.StaminaRegen = 16             -- per second while not sprinting
Config.SpeedPadBonus = 12
Config.SpeedPadDuration = 3

-- Rewards (coins) ----------------------------------------------------------
Config.Rewards = {
	Key = 15,
	Escape = 60,
	Participation = 10,
	Catch = 25,          -- player hunter per catch
	HunterWin = 50,      -- player hunter if nobody escapes
}

-- Upgrades (shop) ----------------------------------------------------------
Config.Upgrades = {
	Stamina = { MaxLevel = 5, BaseCost = 100, CostStep = 75, PerLevel = 20, Label = "Lungs", Desc = "+20 max stamina" },
	Speed = { MaxLevel = 5, BaseCost = 150, CostStep = 100, PerLevel = 1, Label = "Sneakers", Desc = "+1 sprint speed" },
}

function Config.UpgradeCost(name, currentLevel)
	local u = Config.Upgrades[name]
	return u.BaseCost + u.CostStep * currentLevel
end

-- Map ----------------------------------------------------------------------
Config.GridSize = 12
Config.CellSize = 26
Config.LobbyPosition = Vector3.new(0, 80, -330)

Config.DataStoreName = "NightfallRunners_v1"

return Config
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000A"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000009"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Saves coins, wins and upgrades with DataStores.
-- In Studio: Game Settings > Security > "Enable Studio Access to API Services" to test saving.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local DataService = {}

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)

local cache = {} -- [player] = data

local function defaultData()
	return {
		Coins = 0,
		Wins = 0,
		Catches = 0,
		Upgrades = { Stamina = 0, Speed = 0 },
	}
end

local function key(player)
	return "u_" .. player.UserId
end

local function refresh(player)
	local data = cache[player]
	if not data then
		return
	end
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Coins.Value = data.Coins
		stats.Escapes.Value = data.Wins
	end
	local up = data.Upgrades
	player:SetAttribute("StaminaLevel", up.Stamina)
	player:SetAttribute("SpeedLevel", up.Speed)
	player:SetAttribute("MaxStamina", Config.MaxStamina + up.Stamina * Config.Upgrades.Stamina.PerLevel)
	player:SetAttribute("SprintSpeed", Config.SprintSpeed + up.Speed * Config.Upgrades.Speed.PerLevel)
end

function DataService.Load(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = stats
	local wins = Instance.new("IntValue")
	wins.Name = "Escapes"
	wins.Parent = stats
	stats.Parent = player

	local data = defaultData()
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok and type(result) == "table" then
			data.Coins = tonumber(result.Coins) or 0
			data.Wins = tonumber(result.Wins) or 0
			data.Catches = tonumber(result.Catches) or 0
			if type(result.Upgrades) == "table" then
				data.Upgrades.Stamina = tonumber(result.Upgrades.Stamina) or 0
				data.Upgrades.Speed = tonumber(result.Upgrades.Speed) or 0
			end
		elseif not ok then
			warn("[DataService] load failed for", player.Name, result)
		end
	end
	cache[player] = data
	refresh(player)
end

function DataService.Save(player)
	local data = cache[player]
	if not data or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(key(player), data)
	end)
	if not ok then
		warn("[DataService] save failed for", player.Name, err)
	end
end

function DataService.Release(player)
	DataService.Save(player)
	cache[player] = nil
end

function DataService.AddCoins(player, amount)
	local data = cache[player]
	if data then
		data.Coins += amount
		refresh(player)
	end
end

function DataService.AddWin(player)
	local data = cache[player]
	if data then
		data.Wins += 1
		refresh(player)
	end
end

function DataService.AddCatch(player)
	local data = cache[player]
	if data then
		data.Catches += 1
	end
end

function DataService.TryUpgrade(player, name)
	local data = cache[player]
	local info = Config.Upgrades[name]
	if not data or not info then
		return false, "Unknown upgrade"
	end
	local level = data.Upgrades[name]
	if level >= info.MaxLevel then
		return false, "Already maxed!"
	end
	local cost = Config.UpgradeCost(name, level)
	if data.Coins < cost then
		return false, ("Need %d more coins"):format(cost - data.Coins)
	end
	data.Coins -= cost
	data.Upgrades[name] = level + 1
	refresh(player)
	return true, ("%s upgraded to level %d!"):format(info.Label, level + 1)
end

function DataService.SaveAll()
	for player in pairs(cache) do
		task.spawn(DataService.Save, player)
	end
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">HunterAI</string><ProtectedString name="Source"><![CDATA[-- AI Hunter: patrols, spots runaways by sight / sound, chases with pathfinding.

local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local HunterAI = {}
HunterAI.__index = HunterAI

local BODY = Color3.fromRGB(18, 16, 22)
local EYE = Color3.fromRGB(255, 20, 40)

local function makePart(model, name, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function motor(name, part0, part1, c0, c1)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = c1
	m.Parent = part0
	return m
end

local function weld(part0, part1, c0)
	local w = Instance.new("Weld")
	w.Part0 = part0
	w.Part1 = part1
	w.C0 = c0
	w.Parent = part1
	part1.CFrame = part0.CFrame * c0
end

local function buildRig(spawnCFrame, number)
	local model = Instance.new("Model")
	model.Name = "Hunter" .. number

	local root = makePart(model, "HumanoidRootPart", Vector3.new(2, 2, 1), BODY)
	root.Transparency = 1
	root.CanCollide = true
	root.Massless = false
	root.CFrame = spawnCFrame
	model.PrimaryPart = root

	local torso = makePart(model, "Torso", Vector3.new(2.6, 3.2, 1.3), BODY)
	local head = makePart(model, "Head", Vector3.new(1.7, 1.9, 1.7), BODY)
	local lArm = makePart(model, "Left Arm", Vector3.new(0.8, 3.8, 0.8), BODY)
	local rArm = makePart(model, "Right Arm", Vector3.new(0.8, 3.8, 0.8), BODY)
	local lLeg = makePart(model, "Left Leg", Vector3.new(1, 3, 1), BODY)
	local rLeg = makePart(model, "Right Leg", Vector3.new(1, 3, 1), BODY)

	-- joints (clients animate these locally); place parts to match
	local function joint(name, p0, p1, c0, c1)
		motor(name, p0, p1, c0, c1)
		p1.CFrame = p0.CFrame * c0 * c1:Inverse()
	end
	joint("RootJoint", root, torso, CFrame.new(0, 0.5, 0), CFrame.new())
	joint("Neck", torso, head, CFrame.new(0, 1.6, 0), CFrame.new(0, -1.0, 0))
	joint("Left Shoulder", torso, lArm, CFrame.new(-1.75, 1.3, 0), CFrame.new(0, 1.6, 0))
	joint("Right Shoulder", torso, rArm, CFrame.new(1.75, 1.3, 0), CFrame.new(0, 1.6, 0))
	joint("Left Hip", torso, lLeg, CFrame.new(-0.6, -1.6, 0), CFrame.new(0, 1.5, 0))
	joint("Right Hip", torso, rLeg, CFrame.new(0.6, -1.6, 0), CFrame.new(0, 1.5, 0))

	-- glowing eyes + grin
	for _, x in ipairs({ -0.38, 0.38 }) do
		local eye = makePart(model, "Eye", Vector3.new(0.35, 0.22, 0.1), EYE, Enum.Material.Neon)
		weld(head, eye, CFrame.new(x, 0.25, -0.86))
	end
	local mouth = makePart(model, "Mouth", Vector3.new(0.9, 0.12, 0.1), EYE, Enum.Material.Neon)
	weld(head, mouth, CFrame.new(0, -0.4, -0.86))

	local light = Instance.new("PointLight")
	light.Color = EYE
	light.Range = 18
	light.Brightness = 3
	light.Parent = head

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15 -- uses HipHeight with a custom rig
	humanoid.HipHeight = 3.1
	humanoid.WalkSpeed = Config.HunterPatrolSpeed
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge
	humanoid.Parent = model

	return model, humanoid, root
end

local count = 0

-- params: SpawnCFrame, Parent, GetTargets() -> { {Player, Root, Hidden} }, OnCatch(player), PatrolPoints
function HunterAI.new(params)
	count += 1
	local self = setmetatable({}, HunterAI)
	self.Model, self.Humanoid, self.Root = buildRig(params.SpawnCFrame, count)
	self.Root.Anchored = true
	self.Model.Parent = params.Parent

	self.GetTargets = params.GetTargets
	self.OnCatch = params.OnCatch
	self.PatrolPoints = params.PatrolPoints
	self.Rng = Random.new()

	self.Path = PathfindingService:CreatePath({
		AgentRadius = 2.5,
		AgentHeight = 7,
		AgentCanJump = true,
		WaypointSpacing = 6,
	})
	self.Waypoints = nil
	self.WpIndex = 0
	self.Goal = nil
	self.LastPathTime = 0
	self.LastKnown = nil
	self.PatrolGoal = nil
	self.Chasing = false
	self.Enraged = false
	self.Frenzy = false
	self.Active = false
	self.Destroyed = false
	return self
end

function HunterAI:Release()
	if self.Active or self.Destroyed then
		return
	end
	self.Active = true
	self.Root.Anchored = false
	pcall(function()
		self.Root:SetNetworkOwner(nil)
	end)
	task.spawn(function()
		self:_loop()
	end)
end

function HunterAI:SetEnraged(on)
	self.Enraged = on
end

function HunterAI:SetFrenzy(on)
	self.Frenzy = on
end

function HunterAI:Destroy()
	self.Destroyed = true
	self.Active = false
	if self.Model then
		self.Model:Destroy()
	end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

function HunterAI:_canSee(targetRoot)
	local origin = self.Root.Position + Vector3.new(0, 2.5, 0)
	local dir = targetRoot.Position - origin
	if dir.Magnitude > Config.HunterSightRange then
		return false
	end
	rayParams.FilterDescendantsInstances = { self.Model, targetRoot.Parent, workspace:FindFirstChild("Hunters") }
	local hit = workspace:Raycast(origin, dir, rayParams)
	if hit and hit.Instance and hit.Instance.Parent and hit.Instance.Parent:FindFirstChildOfClass("Humanoid") then
		hit = nil -- another character in the way doesn't block sight
	end
	return hit == nil
end

function HunterAI:_pickTarget(targets)
	local best, bestDist = nil, math.huge
	local myPos = self.Root.Position
	for _, t in ipairs(targets) do
		local d = (t.Root.Position - myPos).Magnitude
		local detected
		if t.Hidden then
			detected = d <= Config.HiddenDetectRange
		elseif self.Frenzy then
			detected = true
		else
			detected = d <= Config.HunterHearRange or self:_canSee(t.Root)
		end
		if detected and d < bestDist then
			best, bestDist = t, d
		end
	end
	return best, bestDist
end

function HunterAI:_computePath(goal)
	self.LastPathTime = os.clock()
	self.Goal = goal
	local ok = pcall(function()
		self.Path:ComputeAsync(self.Root.Position, goal)
	end)
	if ok and self.Path.Status == Enum.PathStatus.Success then
		self.Waypoints = self.Path:GetWaypoints()
		self.WpIndex = math.min(2, #self.Waypoints)
	else
		self.Waypoints = nil
	end
end

function HunterAI:_followPath()
	local wps = self.Waypoints
	if not wps then
		return false
	end
	local wp = wps[self.WpIndex]
	while wp do
		local flat = (wp.Position - self.Root.Position) * Vector3.new(1, 0, 1)
		if flat.Magnitude < 3 then
			self.WpIndex += 1
			wp = wps[self.WpIndex]
		else
			break
		end
	end
	if not wp then
		self.Waypoints = nil
		return false
	end
	if wp.Action == Enum.PathWaypointAction.Jump then
		self.Humanoid.Jump = true
	end
	self.Humanoid:MoveTo(wp.Position)
	return true
end

function HunterAI:_newPatrolGoal(targets)
	-- Bias patrols toward runaways so the hunter keeps up the pressure
	if #targets > 0 and self.Rng:NextNumber() < 0.55 then
		local t = targets[self.Rng:NextInteger(1, #targets)]
		local offset = Vector3.new(self.Rng:NextNumber(-35, 35), 0, self.Rng:NextNumber(-35, 35))
		local nearest, nd = nil, math.huge
		for _, p in ipairs(self.PatrolPoints) do
			local d = (p - (t.Root.Position + offset)).Magnitude
			if d < nd then
				nearest, nd = p, d
			end
		end
		return nearest
	end
	return self.PatrolPoints[self.Rng:NextInteger(1, #self.PatrolPoints)]
end

function HunterAI:_loop()
	local lastPos = self.Root.Position
	local lastStuckCheck = os.clock()
	local stuckStrikes = 0

	while self.Active and not self.Destroyed and self.Model.Parent do
		local targets = self.GetTargets()

		-- catch check
		for _, t in ipairs(targets) do
			if (t.Root.Position - self.Root.Position).Magnitude <= Config.CatchRadius then
				self.OnCatch(t.Player)
			end
		end

		local target, dist = self:_pickTarget(targets)
		local chaseSpeed = Config.HunterChaseSpeed + (self.Enraged and Config.HunterEnragedBonus or 0)

		if target then
			self.Chasing = true
			self.LastKnown = target.Root.Position
			self.Humanoid.WalkSpeed = chaseSpeed
			local heightDiff = math.abs(target.Root.Position.Y - self.Root.Position.Y)
			if dist < 40 and heightDiff < 4 and self:_canSee(target.Root) then
				-- straight at them
				self.Waypoints = nil
				self.Humanoid:MoveTo(target.Root.Position + target.Root.AssemblyLinearVelocity * 0.15)
			else
				if not self.Waypoints or os.clock() - self.LastPathTime > 0.5
					or (self.Goal and (self.Goal - target.Root.Position).Magnitude > 8) then
					self:_computePath(target.Root.Position)
				end
				if not self:_followPath() then
					self.Humanoid:MoveTo(target.Root.Position)
				end
			end
		elseif self.LastKnown then
			-- investigate last known position
			self.Chasing = false
			self.Humanoid.WalkSpeed = chaseSpeed - 2
			if not self.Waypoints or (self.Goal and (self.Goal - self.LastKnown).Magnitude > 2) then
				self:_computePath(self.LastKnown)
			end
			if not self:_followPath() or (self.Root.Position - self.LastKnown).Magnitude < 5 then
				self.LastKnown = nil
				self.Waypoints = nil
			end
		else
			self.Chasing = false
			self.Humanoid.WalkSpeed = Config.HunterPatrolSpeed + (self.Enraged and 2 or 0)
			if not self.PatrolGoal or (self.Root.Position - self.PatrolGoal).Magnitude < 6 then
				self.PatrolGoal = self:_newPatrolGoal(targets)
				self.Waypoints = nil
			end
			if not self.Waypoints then
				self:_computePath(self.PatrolGoal)
				if not self.Waypoints then
					self.PatrolGoal = nil
				end
			end
			self:_followPath()
		end

		self.Model:SetAttribute("Chasing", self.Chasing)

		-- stuck detection
		if os.clock() - lastStuckCheck > 1.2 then
			local moved = (self.Root.Position - lastPos).Magnitude
			if moved < 1.5 then
				stuckStrikes += 1
				self.Humanoid.Jump = true
				self.Waypoints = nil
				if stuckStrikes >= 4 then
					self.PatrolGoal = nil
					self.LastKnown = nil
					stuckStrikes = 0
				end
			else
				stuckStrikes = 0
			end
			lastPos = self.Root.Position
			lastStuckCheck = os.clock()
		end

		-- fell out of the world? bring it back
		if self.Root.Position.Y < -30 and #self.PatrolPoints > 0 then
			self.Model:PivotTo(CFrame.new(self.PatrolPoints[1] + Vector3.new(0, 6, 0)))
		end

		task.wait(0.1)
	end
end

return HunterAI
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000007"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Nightfall Runners :: main server game loop

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))
local HunterAI = require(script.Parent:WaitForChild("HunterAI"))
local DataService = require(script.Parent:WaitForChild("DataService"))

---------------------------------------------------------------------------
-- Remotes + replicated game state
---------------------------------------------------------------------------
local Remotes = Instance.new("Folder")
Remotes.Name = "Remotes"
local NotifyEvent = Instance.new("RemoteEvent")
NotifyEvent.Name = "Notify"
NotifyEvent.Parent = Remotes
local SplashEvent = Instance.new("RemoteEvent")
SplashEvent.Name = "Splash"
SplashEvent.Parent = Remotes
local EffectEvent = Instance.new("RemoteEvent")
EffectEvent.Name = "Effect"
EffectEvent.Parent = Remotes
local BuyUpgrade = Instance.new("RemoteFunction")
BuyUpgrade.Name = "BuyUpgrade"
BuyUpgrade.Parent = Remotes
Remotes.Parent = ReplicatedStorage

local GameState = Instance.new("Configuration")
GameState.Name = "GameState"
GameState:SetAttribute("Phase", "Waiting")
GameState:SetAttribute("TimeLeft", 0)
GameState:SetAttribute("KeysCollected", 0)
GameState:SetAttribute("KeysNeeded", Config.KeysNeeded)
GameState:SetAttribute("ExitOpen", false)
GameState:SetAttribute("RunawaysLeft", 0)
GameState:SetAttribute("HunterReleased", false)
GameState.Parent = ReplicatedStorage

local Hunters = Instance.new("Folder")
Hunters.Name = "Hunters"
Hunters.Parent = workspace

---------------------------------------------------------------------------
-- Atmosphere
---------------------------------------------------------------------------
Lighting.ClockTime = 20.6
Lighting.Brightness = 1.6
Lighting.Ambient = Color3.fromRGB(70, 60, 100)
Lighting.OutdoorAmbient = Color3.fromRGB(95, 85, 130)
Lighting.EnvironmentDiffuseScale = 0.4
Lighting.EnvironmentSpecularScale = 0.6
pcall(function()
	Lighting.Technology = Enum.Technology.Future
end)
local atmosphere = Instance.new("Atmosphere")
atmosphere.Density = 0.38
atmosphere.Offset = 0.1
atmosphere.Color = Color3.fromRGB(120, 100, 170)
atmosphere.Decay = Color3.fromRGB(60, 40, 90)
atmosphere.Glare = 0
atmosphere.Haze = 1.5
atmosphere.Parent = Lighting
local bloom = Instance.new("BloomEffect")
bloom.Intensity = 0.6
bloom.Size = 28
bloom.Threshold = 1.6
bloom.Parent = Lighting
local cc = Instance.new("ColorCorrectionEffect")
cc.Contrast = 0.1
cc.Saturation = 0.15
cc.TintColor = Color3.fromRGB(240, 235, 255)
cc.Parent = Lighting

local _, lobbySpawn = MapBuilder.BuildLobby(workspace)

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function notify(target, text, color)
	color = color or Color3.fromRGB(255, 255, 255)
	if target then
		NotifyEvent:FireClient(target, text, color)
	else
		NotifyEvent:FireAllClients(text, color)
	end
end

local function splash(target, title, subtitle, color)
	if target then
		SplashEvent:FireClient(target, title, subtitle, color)
	else
		SplashEvent:FireAllClients(title, subtitle, color)
	end
end

local function getRoot(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart"), hum
end

local function setRole(player, role)
	player:SetAttribute("Role", role)
end

local function sendToLobby(player)
	if player.Parent then
		player:LoadCharacter()
	end
end

---------------------------------------------------------------------------
-- Round state
---------------------------------------------------------------------------
local round = nil -- table while a round is running

local function runawayTargets()
	local list = {}
	if not round then
		return list
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player:GetAttribute("Role") == "Runaway" then
			local root = getRoot(player)
			if root then
				table.insert(list, {
					Player = player,
					Root = root,
					Hidden = player:GetAttribute("Hidden") == true,
				})
			end
		end
	end
	return list
end

local function catchPlayer(player, byPlayer)
	if not round or player:GetAttribute("Role") ~= "Runaway" then
		return
	end
	setRole(player, "Caught")
	player:SetAttribute("Hidden", false)
	table.insert(round.Caught, player)

	local root, hum = getRoot(player)
	if hum then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.JumpHeight = 0
	end
	if root then
		EffectEvent:FireAllClients("Caught", root.Position)
	end

	if byPlayer then
		DataService.AddCoins(byPlayer, Config.Rewards.Catch)
		DataService.AddCatch(byPlayer)
		notify(byPlayer, ("+%d coins for catching %s!"):format(Config.Rewards.Catch, player.DisplayName), Color3.fromRGB(255, 120, 120))
	end
	notify(nil, ("💀 %s was caught!"):format(player.DisplayName), Color3.fromRGB(255, 90, 90))
	splash(player, "CAUGHT!", "Spectate your friends from the lobby", Color3.fromRGB(255, 60, 60))

	task.delay(2.5, function()
		if player:GetAttribute("Role") == "Caught" then
			sendToLobby(player)
		end
	end)
end

local function escapePlayer(player)
	if not round or not round.ExitOpen or player:GetAttribute("Role") ~= "Runaway" then
		return
	end
	setRole(player, "Escaped")
	player:SetAttribute("Hidden", false)
	table.insert(round.Escaped, player)
	DataService.AddCoins(player, Config.Rewards.Escape)
	DataService.AddWin(player)
	notify(nil, ("🏁 %s ESCAPED!"):format(player.DisplayName), Color3.fromRGB(120, 255, 140))
	splash(player, "YOU ESCAPED!", ("+%d coins"):format(Config.Rewards.Escape), Color3.fromRGB(120, 255, 140))
	EffectEvent:FireClient(player, "Escaped")
	task.delay(2, function()
		if player:GetAttribute("Role") == "Escaped" then
			sendToLobby(player)
		end
	end)
end

local function openExit()
	if not round or round.ExitOpen then
		return
	end
	round.ExitOpen = true
	GameState:SetAttribute("ExitOpen", true)
	local info = round.Info
	info.Gate.CanCollide = false
	TweenService:Create(info.Gate, TweenInfo.new(1.2), { Transparency = 1 }):Play()
	local light = info.Gate:FindFirstChildOfClass("PointLight")
	if light then
		light.Color = Color3.fromRGB(80, 255, 120)
	end
	info.GateLabel.Text = "🚪 EXIT OPEN!"
	info.GateLabel.TextColor3 = Color3.fromRGB(120, 255, 140)
	info.ExitPlate.Color = Color3.fromRGB(80, 255, 120)
	for _, h in ipairs(round.AIHunters) do
		h:SetEnraged(true)
	end
	splash(nil, "THE EXIT IS OPEN!", "Get to the gate - the Hunter is enraged!", Color3.fromRGB(120, 255, 140))
	EffectEvent:FireAllClients("ExitOpen", info.ExitPosition)
end

local function collectKey(player, keyModel)
	if not round or round.Ended then
		return
	end
	round.Keys += 1
	GameState:SetAttribute("KeysCollected", round.Keys)
	EffectEvent:FireAllClients("Key", keyModel:GetPivot().Position)
	keyModel:Destroy()
	DataService.AddCoins(player, Config.Rewards.Key)
	notify(
		nil,
		("🔑 %s found a key! (%d/%d)"):format(player.DisplayName, math.min(round.Keys, Config.KeysNeeded), Config.KeysNeeded),
		Color3.fromRGB(255, 220, 90)
	)
	if round.Keys >= Config.KeysNeeded then
		openExit()
	end
end

local function spawnKey(position, parent)
	local model = Instance.new("Model")
	model.Name = "Key"

	local function kp(size, offset, shape)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(255, 205, 60)
		if shape then
			p.Shape = shape
		end
		p.Size = size
		p.CFrame = CFrame.new(position) * offset
		p.Parent = model
		return p
	end
	local ring = kp(Vector3.new(0.5, 2, 2), CFrame.new(0, 1.2, 0), Enum.PartType.Cylinder)
	kp(Vector3.new(0.4, 2.6, 0.4), CFrame.new(0, -0.9, 0))
	kp(Vector3.new(0.4, 0.4, 0.9), CFrame.new(0, -1.6, 0.5))
	kp(Vector3.new(0.4, 0.4, 0.7), CFrame.new(0, -0.9, 0.4))
	model.PrimaryPart = ring

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 210, 80)
	light.Range = 14
	light.Brightness = 3
	light.Parent = ring

	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox"
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.Transparency = 1
	hitbox.Size = Vector3.new(6, 7, 6)
	hitbox.Position = position
	hitbox.Parent = model

	MapBuilder.Billboard(ring, "🔑", Color3.fromRGB(255, 220, 90), 46, 46, Vector3.new(0, 3, 0), true, 70)
	CollectionService:AddTag(model, "SpinningKey")
	model.Parent = parent

	local taken = false
	hitbox.Touched:Connect(function(hit)
		if taken then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player and player:GetAttribute("Role") == "Runaway" then
			taken = true
			collectKey(player, model)
		end
	end)
end

---------------------------------------------------------------------------
-- Player lifecycle
---------------------------------------------------------------------------
local function setupCharacter(player, character)
	local hum = character:WaitForChild("Humanoid", 5)
	if not hum then
		return
	end
	local role = player:GetAttribute("Role")

	if role == "Hunter" and round and not round.Ended then
		-- respawned hunter goes back to the city
		task.defer(function()
			local root = character:WaitForChild("HumanoidRootPart", 5)
			if root then
				character:PivotTo(round.Info.HunterSpawn)
				round.SetupPlayerHunter(player, character)
			end
		end)
	elseif role == "Runaway" then
		-- should not happen (respawn mid-round) -> counts as caught
		setRole(player, "Caught")
	end

	hum.Died:Connect(function()
		if player:GetAttribute("Role") == "Runaway" and round then
			catchPlayer(player, nil)
		end
	end)
end

Players.PlayerAdded:Connect(function(player)
	setRole(player, "Lobby")
	player:SetAttribute("Hidden", false)
	player:SetAttribute("BoostUntil", 0)
	DataService.Load(player)
	player.CharacterAdded:Connect(function(char)
		setupCharacter(player, char)
	end)
	if player.Character then
		setupCharacter(player, player.Character)
	end
	notify(player, "Welcome to Nightfall Runners! Hold SHIFT to sprint.", Color3.fromRGB(200, 170, 255))
end)

Players.PlayerRemoving:Connect(function(player)
	DataService.Release(player)
end)

game:BindToClose(function()
	DataService.SaveAll()
	task.wait(2)
end)

task.spawn(function()
	while true do
		task.wait(120)
		DataService.SaveAll()
	end
end)

BuyUpgrade.OnServerInvoke = function(player, name)
	if type(name) ~= "string" then
		return false, "Bad request"
	end
	return DataService.TryUpgrade(player, name)
end

---------------------------------------------------------------------------
-- Round flow
---------------------------------------------------------------------------
local function setPhase(phase)
	GameState:SetAttribute("Phase", phase)
end

local function startRound()
	local rng = Random.new()
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = "Round"
	mapFolder.Parent = workspace
	local info = MapBuilder.Build(rng, mapFolder)

	round = {
		Info = info,
		Folder = mapFolder,
		Keys = 0,
		ExitOpen = false,
		Escaped = {},
		Caught = {},
		AIHunters = {},
		PlayerHunter = nil,
		Released = false,
		Ended = false,
		Participants = {},
		Frenzy = false,
	}

	GameState:SetAttribute("KeysCollected", 0)
	GameState:SetAttribute("KeysNeeded", Config.KeysNeeded)
	GameState:SetAttribute("ExitOpen", false)
	GameState:SetAttribute("HunterReleased", false)

	for _, pos in ipairs(info.KeySpots) do
		spawnKey(pos, mapFolder)
	end

	-- speed pads
	local padDebounce = {}
	for _, pad in ipairs(info.SpeedPads) do
		pad.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			if not player or player:GetAttribute("Role") ~= "Runaway" then
				return
			end
			if padDebounce[player] and os.clock() - padDebounce[player] < 1 then
				return
			end
			padDebounce[player] = os.clock()
			player:SetAttribute("BoostUntil", workspace:GetServerTimeNow() + Config.SpeedPadDuration)
			EffectEvent:FireClient(player, "Boost")
		end)
	end

	info.ExitZone.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player then
			escapePlayer(player)
		end
	end)

	-- who's playing
	local participants = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if getRoot(p) then
			table.insert(participants, p)
		end
	end
	round.Participants = participants

	local playerHunter = nil
	if #participants >= Config.PlayerHunterMinPlayers then
		playerHunter = participants[rng:NextInteger(1, #participants)]
	end

	function round.SetupPlayerHunter(player, character)
		local hum = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		if hum then
			hum.WalkSpeed = Config.PlayerHunterSpeed
		end
		if not character:FindFirstChild("HunterGlow") then
			local hl = Instance.new("Highlight")
			hl.Name = "HunterGlow"
			hl.FillColor = Color3.fromRGB(255, 30, 50)
			hl.FillTransparency = 0.55
			hl.OutlineColor = Color3.fromRGB(255, 80, 80)
			hl.Parent = character
		end
		if root then
			root.Anchored = not round.Released
		end
	end

	local spawnIndex = 0
	for _, p in ipairs(participants) do
		local root = getRoot(p)
		if p == playerHunter then
			round.PlayerHunter = p
			setRole(p, "Hunter")
			p.Character:PivotTo(info.HunterSpawn)
			round.SetupPlayerHunter(p, p.Character)
			splash(p, "YOU ARE THE HUNTER", "Catch every runaway before they escape!", Color3.fromRGB(255, 60, 60))
		else
			spawnIndex += 1
			setRole(p, "Runaway")
			p:SetAttribute("Hidden", false)
			local cf = info.RunawaySpawns[(spawnIndex - 1) % #info.RunawaySpawns + 1]
			p.Character:PivotTo(cf)
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
			end
			splash(p, "RUN!", ("Find %d keys and escape the city"):format(Config.KeysNeeded), Color3.fromRGB(255, 220, 90))
		end
	end

	-- AI hunter (always at least one)
	local function addAIHunter()
		local h = HunterAI.new({
			SpawnCFrame = info.HunterSpawn * CFrame.new(#round.AIHunters * 4, 0, 0),
			Parent = Hunters,
			GetTargets = runawayTargets,
			OnCatch = function(player)
				catchPlayer(player, nil)
			end,
			PatrolPoints = info.PatrolPoints,
		})
		h:SetEnraged(round.ExitOpen)
		h:SetFrenzy(round.Frenzy)
		table.insert(round.AIHunters, h)
		return h
	end
	round.AddAIHunter = addAIHunter
	addAIHunter()
end

local function releaseHunters()
	round.Released = true
	GameState:SetAttribute("HunterReleased", true)
	for _, h in ipairs(round.AIHunters) do
		h:Release()
	end
	if round.PlayerHunter then
		local root = getRoot(round.PlayerHunter)
		if root then
			root.Anchored = false
		end
	end
	splash(nil, "THE HUNTER IS LOOSE", "Stay out of sight...", Color3.fromRGB(255, 50, 70))
	EffectEvent:FireAllClients("Release")
end

local function updateHidden()
	for _, player in ipairs(Players:GetPlayers()) do
		local hidden = false
		if player:GetAttribute("Role") == "Runaway" then
			local root = getRoot(player)
			if root then
				for _, bush in ipairs(round.Info.Bushes) do
					local d = root.Position - bush.Position
					if Vector3.new(d.X, 0, d.Z).Magnitude < bush.Radius and root.Position.Y < bush.Position.Y + 4 then
						hidden = true
						break
					end
				end
			end
		end
		if player:GetAttribute("Hidden") ~= hidden then
			player:SetAttribute("Hidden", hidden)
		end
	end
end

local function countRunaways()
	local n = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if player:GetAttribute("Role") == "Runaway" then
			n += 1
		end
	end
	return n
end

local function runRound()
	setPhase("Round")
	local startTime = os.clock()
	local nextExtra = Config.HunterReleaseDelay + Config.ExtraHunterEvery

	while true do
		local elapsed = os.clock() - startTime
		local timeLeft = math.max(0, Config.RoundTime - elapsed)
		GameState:SetAttribute("TimeLeft", math.ceil(timeLeft))

		if not round.Released and elapsed >= Config.HunterReleaseDelay then
			releaseHunters()
		end

		if round.Released and elapsed >= nextExtra and #round.AIHunters < Config.MaxAIHunters then
			nextExtra += Config.ExtraHunterEvery
			local h = round.AddAIHunter()
			h:Release()
			notify(nil, "👹 Another Hunter has entered the city!", Color3.fromRGB(255, 70, 90))
			EffectEvent:FireAllClients("Release")
		end

		if not round.Frenzy and timeLeft <= Config.FrenzyTime then
			round.Frenzy = true
			for _, h in ipairs(round.AIHunters) do
				h:SetFrenzy(true)
			end
			splash(nil, "FRENZY!", "The Hunters can sense you now - hurry!", Color3.fromRGB(255, 40, 40))
		end

		-- player hunter catches
		if round.Released and round.PlayerHunter and round.PlayerHunter.Parent then
			local hRoot = getRoot(round.PlayerHunter)
			if hRoot then
				for _, t in ipairs(runawayTargets()) do
					if (t.Root.Position - hRoot.Position).Magnitude <= Config.CatchRadius + 0.5 then
						catchPlayer(t.Player, round.PlayerHunter)
					end
				end
			end
		end

		updateHidden()

		local left = countRunaways()
		GameState:SetAttribute("RunawaysLeft", left)
		if left == 0 or timeLeft <= 0 then
			break
		end
		task.wait(0.1)
	end
end

local function endRound()
	round.Ended = true
	setPhase("Ending")

	-- anyone still running when time is up gets caught by the night
	local timedOut = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player:GetAttribute("Role") == "Runaway" then
			setRole(player, "Caught")
			table.insert(round.Caught, player)
			table.insert(timedOut, player)
		end
	end

	for _, player in ipairs(round.Participants) do
		if player.Parent then
			DataService.AddCoins(player, Config.Rewards.Participation)
		end
	end

	local escaped = #round.Escaped
	local title, sub, color
	if escaped > 0 then
		local names = {}
		for _, p in ipairs(round.Escaped) do
			table.insert(names, p.DisplayName)
		end
		title = escaped == 1 and "1 RUNAWAY ESCAPED" or (escaped .. " RUNAWAYS ESCAPED")
		sub = table.concat(names, ", ")
		color = Color3.fromRGB(120, 255, 140)
	else
		title = "THE HUNTERS WIN"
		sub = #timedOut > 0 and "Time ran out..." or "Nobody made it out."
		color = Color3.fromRGB(255, 60, 70)
		if round.PlayerHunter and round.PlayerHunter.Parent then
			DataService.AddCoins(round.PlayerHunter, Config.Rewards.HunterWin)
			notify(round.PlayerHunter, ("+%d coins - you win!"):format(Config.Rewards.HunterWin), Color3.fromRGB(255, 120, 120))
		end
	end
	splash(nil, title, sub, color)

	for _, h in ipairs(round.AIHunters) do
		h:Destroy()
	end
	task.wait(Config.EndingTime)

	for _, player in ipairs(Players:GetPlayers()) do
		local role = player:GetAttribute("Role")
		setRole(player, "Lobby")
		player:SetAttribute("Hidden", false)
		if role == "Hunter" or role == "Caught" or role == "Runaway" then
			sendToLobby(player)
		end
	end

	round.Folder:Destroy()
	round = nil
	GameState:SetAttribute("ExitOpen", false)
	GameState:SetAttribute("KeysCollected", 0)
	GameState:SetAttribute("RunawaysLeft", 0)
	GameState:SetAttribute("HunterReleased", false)
end

-- Main loop ---------------------------------------------------------------
while true do
	setPhase("Waiting")
	while #Players:GetPlayers() < Config.MinPlayers do
		task.wait(1)
	end

	setPhase("Intermission")
	local ready = true
	for t = Config.IntermissionTime, 1, -1 do
		GameState:SetAttribute("TimeLeft", t)
		task.wait(1)
		if #Players:GetPlayers() < Config.MinPlayers then
			ready = false
			break
		end
	end

	if ready then
		local ok, err = pcall(startRound)
		if ok then
			runRound()
			endRound()
		else
			warn("[Nightfall] failed to start round:", err)
			if round and round.Folder then
				round.Folder:Destroy()
			end
			round = nil
			task.wait(3)
		end
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Procedurally builds the lobby and a new neon city every round.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapBuilder = {}

local BUILDING_COLORS = {
	Color3.fromRGB(52, 48, 68),
	Color3.fromRGB(44, 52, 66),
	Color3.fromRGB(66, 50, 58),
	Color3.fromRGB(38, 42, 52),
	Color3.fromRGB(58, 58, 64),
}
local NEON_COLORS = {
	Color3.fromRGB(255, 70, 160),
	Color3.fromRGB(60, 220, 255),
	Color3.fromRGB(255, 200, 70),
	Color3.fromRGB(150, 90, 255),
}
local CAR_COLORS = {
	Color3.fromRGB(200, 50, 50),
	Color3.fromRGB(40, 110, 200),
	Color3.fromRGB(230, 230, 230),
	Color3.fromRGB(240, 180, 40),
	Color3.fromRGB(30, 30, 30),
}

local function newPart(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function addLight(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = part
	return l
end

function MapBuilder.Billboard(part, text, color, w, h, offset, alwaysOnTop, maxDistance)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(w, h)
	bb.StudsOffset = offset or Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = alwaysOnTop == true
	bb.LightInfluence = 0
	if maxDistance then
		bb.MaxDistance = maxDistance
	end
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = color
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextStrokeTransparency = 0.2
	t.Parent = bb
	bb.Parent = part
	return bb, t
end

local function pick(rng, list)
	return list[rng:NextInteger(1, #list)]
end

---------------------------------------------------------------------------
-- Lobby
---------------------------------------------------------------------------
function MapBuilder.BuildLobby(parent)
	local model = Instance.new("Model")
	model.Name = "Lobby"
	local c = Config.LobbyPosition
	local S = 90

	newPart(model, {
		Name = "Floor",
		Size = Vector3.new(S, 2, S),
		Position = c - Vector3.new(0, 1, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(30, 28, 44),
	})
	-- neon floor grid
	for i = -2, 2 do
		local off = i * 18
		newPart(model, {
			Size = Vector3.new(0.6, 0.1, S),
			Position = c + Vector3.new(off, 0.05, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(110, 70, 220),
			CanCollide = false,
		})
		newPart(model, {
			Size = Vector3.new(S, 0.1, 0.6),
			Position = c + Vector3.new(0, 0.05, off),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(110, 70, 220),
			CanCollide = false,
		})
	end

	-- glass walls
	local H = 16
	local walls = {
		{ Vector3.new(S, H, 1), Vector3.new(0, H / 2, S / 2) },
		{ Vector3.new(S, H, 1), Vector3.new(0, H / 2, -S / 2) },
		{ Vector3.new(1, H, S), Vector3.new(S / 2, H / 2, 0) },
		{ Vector3.new(1, H, S), Vector3.new(-S / 2, H / 2, 0) },
	}
	for _, w in ipairs(walls) do
		newPart(model, {
			Size = w[1],
			Position = c + w[2],
			Material = Enum.Material.Glass,
			Transparency = 0.65,
			Color = Color3.fromRGB(140, 110, 230),
		})
	end

	-- corner pillars
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local p = newPart(model, {
				Size = Vector3.new(3, H + 4, 3),
				Position = c + Vector3.new(sx * (S / 2 - 2), (H + 4) / 2, sz * (S / 2 - 2)),
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(255, 70, 160),
			})
			addLight(p, p.Color, 28, 2)
		end
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(16, 1, 16)
	spawn.Position = c + Vector3.new(0, 0.5, -10)
	spawn.Material = Enum.Material.Neon
	spawn.Color = Color3.fromRGB(120, 80, 255)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = model

	-- How-to-play board
	local board = newPart(model, {
		Name = "Board",
		Size = Vector3.new(44, 20, 1),
		Position = c + Vector3.new(0, 12, S / 2 - 3),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(15, 12, 25),
	})
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(880, 400)
	sg.LightInfluence = 0
	sg.Parent = board
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.3, 0)
	title.BackgroundTransparency = 1
	title.Text = "NIGHTFALL RUNNERS"
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 90, 170)
	title.Parent = sg
	local body = Instance.new("TextLabel")
	body.Size = UDim2.new(0.92, 0, 0.66, 0)
	body.Position = UDim2.new(0.04, 0, 0.32, 0)
	body.BackgroundTransparency = 1
	body.TextWrapped = true
	body.TextScaled = true
	body.Font = Enum.Font.GothamBold
	body.TextColor3 = Color3.fromRGB(230, 225, 255)
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.Text = ("🔑  Find %d keys hidden around the city\n🚪  Unlock the exit gate and ESCAPE\n👹  The Hunter is coming - don't get caught!\n🌿  Hide inside bushes  •  ⚡ Speed pads boost you\n⇧  Hold SHIFT to sprint (watch your stamina)"):format(
		Config.KeysNeeded
	)
	body.Parent = sg

	model.Parent = parent
	return model, spawn
end

---------------------------------------------------------------------------
-- City map
---------------------------------------------------------------------------
function MapBuilder.Build(rng, parent)
	local N, C = Config.GridSize, Config.CellSize
	local size = N * C
	local half = size / 2

	local model = Instance.new("Model")
	model.Name = "Map"

	local info = {
		Model = model,
		RunawaySpawns = {},
		KeySpots = {},
		PatrolPoints = {},
		Bushes = {},
		SpeedPads = {},
	}

	local function cellCenter(i, j)
		return Vector3.new(-half + (i - 0.5) * C, 0, -half + (j - 0.5) * C)
	end

	-- Ground
	newPart(model, {
		Name = "Ground",
		Size = Vector3.new(size + 60, 4, size + 60),
		Position = Vector3.new(0, -2, 0),
		Material = Enum.Material.Asphalt,
		Color = Color3.fromRGB(38, 38, 44),
	})

	-- Border walls
	local wallH, wallT = 34, 4
	local wallProps = { Material = Enum.Material.Brick, Color = Color3.fromRGB(58, 46, 66) }
	local function wall(sz, pos)
		local w = newPart(model, {
			Name = "Wall",
			Size = sz,
			Position = pos,
			Material = wallProps.Material,
			Color = wallProps.Color,
		})
		newPart(model, {
			Size = Vector3.new(sz.X + 0.2, 0.8, sz.Z + 0.2),
			Position = pos + Vector3.new(0, sz.Y / 2 - 0.4, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 40, 70),
			CanCollide = false,
		})
		return w
	end
	wall(Vector3.new(size + wallT * 2, wallH, wallT), Vector3.new(0, wallH / 2, -half - wallT / 2))
	wall(Vector3.new(wallT, wallH, size), Vector3.new(half + wallT / 2, wallH / 2, 0))
	wall(Vector3.new(wallT, wallH, size), Vector3.new(-half - wallT / 2, wallH / 2, 0))

	-- North wall with the exit gap
	local gapW = 18
	local exitX = cellCenter(rng:NextInteger(3, N - 2), N).X
	local leftLen = (exitX - gapW / 2) - (-half - wallT)
	local rightLen = (half + wallT) - (exitX + gapW / 2)
	wall(Vector3.new(leftLen, wallH, wallT), Vector3.new(-half - wallT + leftLen / 2, wallH / 2, half + wallT / 2))
	wall(Vector3.new(rightLen, wallH, wallT), Vector3.new(half + wallT - rightLen / 2, wallH / 2, half + wallT / 2))

	local gate = newPart(model, {
		Name = "Gate",
		Size = Vector3.new(gapW, wallH, 1.5),
		Position = Vector3.new(exitX, wallH / 2, half + wallT / 2),
		Material = Enum.Material.ForceField,
		Color = Color3.fromRGB(255, 40, 60),
	})
	addLight(gate, gate.Color, 30, 3)
	local _, gateLabel = MapBuilder.Billboard(gate, "🔒 EXIT", Color3.fromRGB(255, 80, 90), 200, 60, Vector3.new(0, wallH / 2 + 3, 0), true)

	local exitPlate = newPart(model, {
		Name = "ExitPlate",
		Size = Vector3.new(gapW, 0.3, 14),
		Position = Vector3.new(exitX, 0.15, half + wallT + 7),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(80, 80, 90),
		CanCollide = false,
	})
	local exitZone = newPart(model, {
		Name = "ExitZone",
		Size = Vector3.new(gapW, 12, 14),
		Position = Vector3.new(exitX, 6, half + wallT + 7),
		Transparency = 1,
		CanCollide = false,
	})

	info.Gate = gate
	info.GateLabel = gateLabel
	info.ExitPlate = exitPlate
	info.ExitZone = exitZone
	info.ExitPosition = Vector3.new(exitX, 3, half - 6)

	-- Cell layout -----------------------------------------------------------
	local midI, midJ = math.floor(N / 2), math.floor(N / 2)
	local layout = {}
	for i = 1, N do
		layout[i] = {}
		for j = 1, N do
			local t
			if j == 1 or j == N then
				t = "empty"
			elseif (i == midI or i == midI + 1) and (j == midJ or j == midJ + 1) then
				t = "lair"
			else
				local r = rng:NextNumber()
				if r < 0.36 then
					t = "building"
				elseif r < 0.5 then
					t = "crates"
				elseif r < 0.63 then
					t = "bushes"
				elseif r < 0.68 then
					t = "pad"
				else
					t = "empty"
				end
			end
			layout[i][j] = t
		end
	end

	local keyCandidates = {}

	for i = 1, N do
		for j = 1, N do
			local t = layout[i][j]
			local cc = cellCenter(i, j)

			if t == "building" then
				local w = C - rng:NextInteger(8, 11)
				local d = C - rng:NextInteger(8, 11)
				local h = rng:NextInteger(16, 50)
				newPart(model, {
					Name = "Sidewalk",
					Size = Vector3.new(w + 3, 0.3, d + 3),
					Position = cc + Vector3.new(0, 0.15, 0),
					Material = Enum.Material.Concrete,
					Color = Color3.fromRGB(90, 88, 96),
				})
				newPart(model, {
					Name = "Building",
					Size = Vector3.new(w, h, d),
					Position = cc + Vector3.new(0, h / 2, 0),
					Material = pick(rng, { Enum.Material.Concrete, Enum.Material.Brick, Enum.Material.SmoothPlastic }),
					Color = pick(rng, BUILDING_COLORS),
				})
				if rng:NextNumber() < 0.65 then
					local neon = pick(rng, NEON_COLORS)
					for y = 7, h - 4, 8 do
						newPart(model, {
							Size = Vector3.new(w + 0.2, 1, d + 0.2),
							Position = cc + Vector3.new(0, y, 0),
							Material = Enum.Material.Neon,
							Color = neon,
							Transparency = 0.15,
							CanCollide = false,
						})
					end
				end
				local roof = newPart(model, {
					Size = Vector3.new(w + 0.6, 0.6, d + 0.6),
					Position = cc + Vector3.new(0, h + 0.3, 0),
					Material = Enum.Material.Neon,
					Color = pick(rng, NEON_COLORS),
					CanCollide = false,
				})
				if rng:NextNumber() < 0.3 then
					addLight(roof, roof.Color, 40, 1.5)
				end
			elseif t == "crates" then
				local count = rng:NextInteger(2, 4)
				for _ = 1, count do
					local ang = rng:NextNumber() * math.pi * 2
					local rad = rng:NextNumber(6, 9)
					local s = rng:NextInteger(4, 5)
					local pos = cc + Vector3.new(math.cos(ang) * rad, s / 2, math.sin(ang) * rad)
					local crate = newPart(model, {
						Name = "Crate",
						Size = Vector3.new(s, s, s),
						CFrame = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber() * math.pi, 0),
						Material = Enum.Material.WoodPlanks,
						Color = Color3.fromRGB(150, 105, 60),
					})
					if rng:NextNumber() < 0.3 then
						newPart(model, {
							Name = "Crate",
							Size = Vector3.new(s - 1, s - 1, s - 1),
							CFrame = crate.CFrame * CFrame.new(0, s - 0.5, 0) * CFrame.Angles(0, 0.4, 0),
							Material = Enum.Material.WoodPlanks,
							Color = Color3.fromRGB(130, 90, 50),
						})
					end
				end
				table.insert(keyCandidates, cc)
				table.insert(info.PatrolPoints, cc)
			elseif t == "bushes" then
				local count = rng:NextInteger(2, 3)
				for k = 1, count do
					local ang = (k / count) * math.pi * 2 + rng:NextNumber()
					local rad = rng:NextNumber(3, 7)
					local pos = cc + Vector3.new(math.cos(ang) * rad, 3.2, math.sin(ang) * rad)
					local bush = newPart(model, {
						Name = "Bush",
						Shape = Enum.PartType.Ball,
						Size = Vector3.new(9.5, 9.5, 9.5),
						Position = pos,
						Material = Enum.Material.Grass,
						Color = Color3.fromRGB(40, rng:NextInteger(95, 130), 50),
						CanCollide = false,
						CanQuery = false,
						Transparency = 0.05,
					})
					table.insert(info.Bushes, { Position = bush.Position, Radius = 4.3 })
				end
				table.insert(info.PatrolPoints, cc)
			elseif t == "pad" then
				local pad = newPart(model, {
					Name = "SpeedPad",
					Size = Vector3.new(9, 0.4, 9),
					Position = cc + Vector3.new(0, 0.2, 0),
					Material = Enum.Material.Neon,
					Color = Color3.fromRGB(60, 230, 255),
					CanCollide = false,
				})
				addLight(pad, pad.Color, 16, 2)
				local sg = Instance.new("SurfaceGui")
				sg.Face = Enum.NormalId.Top
				sg.LightInfluence = 0
				sg.Parent = pad
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.fromScale(1, 1)
				lbl.BackgroundTransparency = 1
				lbl.Text = "⚡"
				lbl.TextScaled = true
				lbl.TextColor3 = Color3.new(1, 1, 1)
				lbl.Parent = sg
				table.insert(info.SpeedPads, pad)
				table.insert(info.PatrolPoints, cc)
			elseif t == "empty" then
				local roll = rng:NextNumber()
				if roll < 0.35 then
					-- street lamp
					local base = cc + Vector3.new(C / 2 - 4, 0, C / 2 - 4)
					newPart(model, {
						Name = "LampPost",
						Size = Vector3.new(0.8, 14, 0.8),
						Position = base + Vector3.new(0, 7, 0),
						Material = Enum.Material.Metal,
						Color = Color3.fromRGB(30, 30, 34),
					})
					local head = newPart(model, {
						Size = Vector3.new(2.4, 0.8, 2.4),
						Position = base + Vector3.new(0, 14.2, 0),
						Material = Enum.Material.Neon,
						Color = Color3.fromRGB(255, 210, 140),
						CanCollide = false,
					})
					addLight(head, Color3.fromRGB(255, 200, 130), 34, 2.2)
				elseif roll < 0.6 and j > 1 and j < N then
					-- parked car
					local side = rng:NextNumber() < 0.5 and -1 or 1
					local carCF = CFrame.new(cc + Vector3.new(side * 7, 0, 0)) * CFrame.Angles(0, rng:NextNumber(-0.2, 0.2), 0)
					local color = pick(rng, CAR_COLORS)
					newPart(model, {
						Name = "Car",
						Size = Vector3.new(5, 2.6, 11),
						CFrame = carCF * CFrame.new(0, 1.7, 0),
						Material = Enum.Material.SmoothPlastic,
						Color = color,
					})
					newPart(model, {
						Name = "Car",
						Size = Vector3.new(4.6, 2, 5.5),
						CFrame = carCF * CFrame.new(0, 4, 0.5),
						Material = Enum.Material.Glass,
						Transparency = 0.3,
						Color = Color3.fromRGB(30, 40, 60),
					})
					for _, x in ipairs({ -1.8, 1.8 }) do
						local light = newPart(model, {
							Size = Vector3.new(1, 0.6, 0.2),
							CFrame = carCF * CFrame.new(x, 2, -5.55),
							Material = Enum.Material.Neon,
							Color = Color3.fromRGB(255, 250, 210),
							CanCollide = false,
						})
						if x > 0 then
							addLight(light, light.Color, 14, 1)
						end
					end
				end
				if j > 1 and j < N then
					table.insert(keyCandidates, cc)
				end
				table.insert(info.PatrolPoints, cc)
			end

			if j == 1 and i > 1 and i < N then
				table.insert(info.RunawaySpawns, CFrame.new(cc + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.pi, 0))
			end
		end
	end

	-- Start line
	newPart(model, {
		Size = Vector3.new(size, 0.1, 1.5),
		Position = Vector3.new(0, 0.05, -half + C),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(120, 255, 140),
		CanCollide = false,
	})

	-- Hunter lair (center)
	local lairPos = cellCenter(midI, midJ) + Vector3.new(C / 2, 0, C / 2)
	local lairFloor = newPart(model, {
		Name = "Lair",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 26, 26),
		CFrame = CFrame.new(lairPos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(45, 10, 15),
	})
	newPart(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.45, 20, 20),
		CFrame = lairFloor.CFrame,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(200, 20, 40),
		CanCollide = false,
	})
	for k = 1, 6 do
		local a = k / 6 * math.pi * 2
		local p = newPart(model, {
			Size = Vector3.new(1.2, 9, 1.2),
			Position = lairPos + Vector3.new(math.cos(a) * 12, 4.5, math.sin(a) * 12),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 30, 50),
		})
		if k % 2 == 0 then
			addLight(p, p.Color, 24, 2)
		end
	end
	info.HunterSpawn = CFrame.new(lairPos + Vector3.new(0, 5, 0))
	table.insert(info.PatrolPoints, lairPos)

	-- Pick key spots, spread out
	for idx = #keyCandidates, 2, -1 do
		local swap = rng:NextInteger(1, idx)
		keyCandidates[idx], keyCandidates[swap] = keyCandidates[swap], keyCandidates[idx]
	end
	local minSpacing = C * 2.2
	for pass = 1, 3 do
		for _, cand in ipairs(keyCandidates) do
			if #info.KeySpots >= Config.KeysToSpawn then
				break
			end
			local ok = true
			for _, chosen in ipairs(info.KeySpots) do
				if (chosen - cand).Magnitude < minSpacing then
					ok = false
					break
				end
			end
			if ok and (cand - lairPos).Magnitude > C then
				table.insert(info.KeySpots, cand + Vector3.new(0, 3, 0))
			end
		end
		minSpacing *= 0.6
	end

	info.Bounds = { Half = half }
	model.Parent = parent
	return info
end

return MapBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000000E"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000000D"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX0000000C"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX0000000B"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Nightfall Runners :: client (HUD, sprint/stamina, effects, spectate, shop)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local HuntersFolder = workspace:WaitForChild("Hunters")

---------------------------------------------------------------------------
-- UI helpers
---------------------------------------------------------------------------
local FONT = Enum.Font.FredokaOne
local FONT_BODY = Enum.Font.GothamBold
local PANEL = Color3.fromRGB(18, 14, 30)
local ACCENT = Color3.fromRGB(150, 100, 255)

local function make(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r)
	return make("UICorner", { CornerRadius = UDim.new(0, r or 12) })
end

local function stroke(color, thickness, transparency)
	return make("UIStroke", {
		Color = color or ACCENT,
		Thickness = thickness or 2,
		Transparency = transparency or 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function label(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or FONT
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.TextScaled = props.TextScaled ~= false
	return make("TextLabel", props)
end

local gui = make("ScreenGui", {
	Name = "NightfallHUD",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

---------------------------------------------------------------------------
-- Danger vignette (red edges)
---------------------------------------------------------------------------
local vignette = make("Frame", {
	Name = "Vignette",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	ZIndex = 0,
	Parent = gui,
})
local vignetteEdges = {}
local function edge(size, pos, rotation)
	local f = make("Frame", {
		Size = size,
		Position = pos,
		BackgroundColor3 = Color3.fromRGB(200, 0, 20),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		Parent = vignette,
	}, {
		make("UIGradient", {
			Rotation = rotation,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	table.insert(vignetteEdges, f)
end
edge(UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0), 90)
edge(UDim2.fromScale(1, 0.3), UDim2.fromScale(0, 0.7), -90)
edge(UDim2.fromScale(0.25, 1), UDim2.fromScale(0, 0), 0)
edge(UDim2.fromScale(0.25, 1), UDim2.fromScale(0.75, 0), 180)

local flash = make("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(1, 1, 1),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ZIndex = 50,
	Parent = gui,
})

---------------------------------------------------------------------------
-- Top status bar
---------------------------------------------------------------------------
local top = make("Frame", {
	Name = "Top",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 14),
	Size = UDim2.fromOffset(330, 74),
	BackgroundColor3 = PANEL,
	BackgroundTransparency = 0.15,
	Parent = gui,
}, { corner(16), stroke(ACCENT, 2, 0.4) })

local phaseLabel = label({
	Size = UDim2.new(1, -20, 0, 20),
	Position = UDim2.fromOffset(10, 8),
	Text = "WAITING FOR PLAYERS",
	TextColor3 = Color3.fromRGB(200, 180, 255),
	Font = FONT_BODY,
	Parent = top,
})
local timerLabel = label({
	Size = UDim2.new(1, -20, 0, 38),
	Position = UDim2.fromOffset(10, 28),
	Text = "",
	Parent = top,
})

local pills = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 94),
	Size = UDim2.fromOffset(330, 34),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
}, {
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
	}),
})
local function pill(text, color)
	local f = make("Frame", {
		Size = UDim2.fromOffset(150, 34),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.15,
		Parent = pills,
	}, { corner(17), stroke(color, 2, 0.3) })
	local l = label({
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.fromOffset(6, 4),
		Text = text,
		TextColor3 = color,
		Parent = f,
	})
	return f, l
end
local keysPill, keysLabel = pill("🔑 0 / 5", Color3.fromRGB(255, 215, 80))
local _, runnersLabel = pill("🏃 0 left", Color3.fromRGB(140, 220, 255))

---------------------------------------------------------------------------
-- Role badge + stamina
---------------------------------------------------------------------------
local bottom = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(320, 70),
	BackgroundTransparency = 1,
	Parent = gui,
})
local roleLabel = label({
	Size = UDim2.new(1, 0, 0, 24),
